# Reference only — this app reads these as plain OS environment variables and does not
# load .env files automatically (no python-dotenv dependency). See backend/README.md for
# how to set them in your shell before running the server.

# Twelve Data (https://twelvedata.com) — used by price_service.py for price/FX lookups.
# Optional: features that need it degrade to "Unavailable" rather than failing when unset.
TWELVE_DATA_API_KEY=

# Financial Modeling Prep (https://financialmodelingprep.com) — used by trending_service.py
# for the Trending Stocks Today tab (gainers/losers/most-active).
# Optional: the tab explains that this key is missing rather than failing when unset.
FMP_API_KEY=
