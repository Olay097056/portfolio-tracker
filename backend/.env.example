# Reference only. The FastAPI app itself reads these as plain OS environment variables
# and does not load .env files automatically. See backend/README.md for how to set them
# in your shell before running the server.
#
# backend/scripts/refresh_screener.py is the one exception — it's a standalone CLI, not
# part of the running app, and does load backend/.env directly via python-dotenv.

# Twelve Data (https://twelvedata.com) — used by price_service.py for price/FX lookups.
# Optional: features that need it degrade to "Unavailable" rather than failing when unset.
TWELVE_DATA_API_KEY=

# Financial Modeling Prep (https://financialmodelingprep.com) — used by trending_service.py
# for the Trending Stocks Today tab (gainers/losers/most-active).
# Optional: the tab explains that this key is missing rather than failing when unset.
FMP_API_KEY=

# Finnhub (https://finnhub.io) — used by backend/scripts/refresh_screener.py to populate
# the Stock Screener's screener_stocks table (ticker universe + fundamentals). Free tier.
# Required only to run that script; the Screener falls back to static demo data without it.
FINNHUB_API_KEY=
